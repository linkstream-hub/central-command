{
  "claude-dev.useGitWorktrees": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "i18n-ally.localesPaths": [
    "tech-pwa/src/lib/i18n"
  ],
  "tailwindCSS.lint.suggestCanonicalClasses": "ignore"
}
