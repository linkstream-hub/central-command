{
  "name": "FLAG Gate Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "flag-gate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1",
      "name": "Receive FLAG Gate",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.RESEND_API_KEY }}"
