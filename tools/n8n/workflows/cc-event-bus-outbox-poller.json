                                         "sendBody":  true,
                                         "specifyBody":  "string",
                                         "body":  "={{ JSON.stringify({ id: $json.id, type: $json.type, occurredAt: new Date().toISOString(), payload: typeof $json.payload === \u0027string\u0027 ? JSON.parse($json.payload) : $json.payload }) }}",
