                      "parameters":  {
                                         "operation":  "executeQuery",
                                         "query":  "UPDATE workflow_events SET status = \u0027delivered\u0027, delivered_at = NOW(), attempts = attempts + 1, last_attempted_at = NOW() WHERE id = \u0027{{ $(\u0027Loop: Each Event\u0027).item.json.id }}\u0027",
