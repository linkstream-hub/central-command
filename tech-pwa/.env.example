# ─── Required — app will not start without these ─────────────────────────────
DATABASE_URL=postgresql://...@...neon.tech/neondb?sslmode=require
AUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ─── Required — API auth ──────────────────────────────────────────────────────
DASHBOARD_API_KEY=...
GAS_INTERNAL_SECRET=...
CRON_SECRET=...

# ─── Required — AI parsing (email intake) ─────────────────────────────────────
GEMINI_API_KEY=...
GOOGLE_GENERATIVE_AI_API_KEY=...

# ─── Required — Email sending (Resend) ───────────────────────────────────────
RESEND_API_KEY=re_...

# ─── Required — Rate limiting (Upstash Redis) ────────────────────────────────
KV_REST_API_URL=https://...upstash.io
KV_REST_API_TOKEN=...

# ─── Required — Push notifications (VAPID) ───────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=push@aptmaintenanceinc.com

# ─── Optional — Gmail direct access (n8n handles polling; needed for manual ops) ─
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REFRESH_TOKEN=...
GMAIL_WATCH_EMAIL=maintenance@aptmaintenanceinc.com

# ─── Optional — GAS dashboard URL (server-only) ─────────────────────────────
DASHBOARD_API_URL=https://script.google.com/macros/s/.../exec
GOOGLE_API_KEY=...

# ─── Optional — next-auth URL overrides (auto-detected in most environments) ─
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=same-as-AUTH_SECRET

# ─── Dev flags (never set in production) ─────────────────────────────────────
# DEV_BYPASS_AUTH=true          # skip Google OAuth — dev login button appears
# NEXT_PUBLIC_DEV_ALLOW_WRITES=true  # allow GAS writes in local dev
# NEXT_PUBLIC_SANDBOX_MODE=true
# ALLOW_MOCK=true
